{
  "name": "Agentic AutoML Orchestrator (Compatible)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "trigger-automl",
        "responseMode": "lastNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        240
      ],
      "id": "webhook-trigger",
      "name": "Webhook Trigger"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/profile_dataset",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"file_path\": $json.body.file_path } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        220,
        240
      ],
      "id": "profile-dataset-node",
      "name": "Profile Dataset"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ \n  {\n    \"model\": \"gpt-4o\",\n    \"messages\": [\n      {\n        \"role\": \"system\",\n        \"content\": \"You are an expert ML Engineer. Write a python training script that loads the dataset at the path specified in the user message, profiles the dataset, trains a logistic regression or random forest model to predict the target variable, and saves 'model.pkl'. Return ONLY valid python code. Do not include markdown formatting.\"\n      },\n      {\n        \"role\": \"user\",\n        \"content\": \"Dataset path: \" + $('Webhook Trigger').item.json.body.file_path + \". Dataset profile: \" + JSON.stringify($json) + \". Target variable: \" + $('Webhook Trigger').item.json.body.target_variable\n      }\n    ]\n  }\n}}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        440,
        240
      ],
      "id": "codegen-agent-node",
      "name": "CodeGen Agent"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/execute_script_safely",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"script_content\": $json.choices[0].message.content } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        660,
        240
      ],
      "id": "execute-script-node",
      "name": "Execute in Sandbox"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-exit-code",
              "leftValue": "={{ $json.exit_code }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        880,
        240
      ],
      "id": "check-run-success",
      "name": "Execution Successful?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ \n  {\n    \"model\": \"gpt-4o\",\n    \"messages\": [\n      {\n        \"role\": \"system\",\n        \"content\": \"The training script failed. Please fix the error and write an updated version. Return ONLY the code.\"\n      },\n      {\n        \"role\": \"user\",\n        \"content\": \"Error:\\n\" + $('Execute in Sandbox').item.json.stderr + \"\\n\\nOriginal Code:\\n\" + $('CodeGen Agent').item.json.choices[0].message.content\n      }\n    ]\n  }\n}}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        780,
        460
      ],
      "id": "debug-agent-node",
      "name": "Debug Agent"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/validate_pipeline",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"model_path\": \"model.pkl\" } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        1120,
        180
      ],
      "id": "validate-pipeline-node",
      "name": "Validate & Package"
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Profile Dataset",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Profile Dataset": {
      "main": [
        [
          {
            "node": "CodeGen Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "CodeGen Agent": {
      "main": [
        [
          {
            "node": "Execute in Sandbox",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute in Sandbox": {
      "main": [
        [
          {
            "node": "Execution Successful?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execution Successful?": {
      "main": [
        [
          {
            "node": "Validate & Package",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Debug Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Debug Agent": {
      "main": [
        [
          {
            "node": "Execute in Sandbox",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
